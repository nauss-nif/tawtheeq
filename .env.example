# ==========================================================================
# منصة "توثيق" — مثال متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية. لا تُودِع .env في Git.
# ==========================================================================

# --- Supabase ---
# من لوحة Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# مفتاح الخدمة (server-only) — لا يُكشف للعميل إطلاقًا
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- حساب المدير (يُقرأ بواسطة seed script فقط) ---
ADMIN_EMAIL=nalshahrani@nauss.edu.sa
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=مدير النظام

# --- قيود التسجيل ---
# نطاق البريد المسموح للمنسقين
ALLOWED_EMAIL_DOMAIN=nauss.edu.sa
# ضع القيمة false لتعطيل قيد النطاق (السماح بأي بريد)
ENFORCE_EMAIL_DOMAIN=true

# --- SharePoint / Microsoft Graph (أرشفة الأصول) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
SHAREPOINT_SITE_ID=your-site-id
SHAREPOINT_DRIVE_ID=your-drive-id
# اسم مكتبة المستندات الهدف (للتوثيق فقط)
SHAREPOINT_LIBRARY_NAME=أرشيف إدارة عمليات التدريب

# --- الذكاء الاصطناعي (توليد نصوص الجلسات) ---
# مفتاح Anthropic (Claude). بدونه تبقى الميزة معطّلة بلطف.
ANTHROPIC_API_KEY=

# --- إعدادات المعالجة ---
# مسار ffmpeg إن لم يكن في PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- عام ---
# الرابط العام للموقع (لـ Open Graph والمشاركة)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
