# ==========================================================================
# منصة "توثيق" — مثال متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية. لا تُودِع .env في Git.
# ==========================================================================

# --- Supabase ---
# من لوحة Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# مفتاح الخدمة (server-only) — لا يُكشف للعميل إطلاقًا
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- حساب المدير (يُقرأ بواسطة seed script فقط) ---
ADMIN_EMAIL=nalshahrani@nauss.edu.sa
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=مدير النظام

# --- قيود التسجيل ---
# نطاق البريد المسموح للمنسقين
ALLOWED_EMAIL_DOMAIN=nauss.edu.sa
# ضع القيمة false لتعطيل قيد النطاق (السماح بأي بريد)
ENFORCE_EMAIL_DOMAIN=true

# --- SharePoint / Microsoft Graph (أرشفة الأصول) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
SHAREPOINT_SITE_ID=your-site-id
SHAREPOINT_DRIVE_ID=your-drive-id
# اسم مكتبة المستندات الهدف (للتوثيق فقط)
SHAREPOINT_LIBRARY_NAME=أرشيف إدارة عمليات التدريب

# --- الذكاء الاصطناعي (توليد نصوص الجلسات) ---
# مفتاح Anthropic (Claude). بدونه تبقى الميزة معطّلة بلطف.
ANTHROPIC_API_KEY=

# --- إعدادات المعالجة ---
# مسار ffmpeg إن لم يكن في PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- عام ---
# الرابط العام للموقع (لـ Open Graph والمشاركة)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================================================
# «الاستوديو الذكي للبرومو» — AI Promo Studio
# كل الخدمات خلف Provider Adapter؛ ترك أي مفتاح فارغًا يعطّل مزوّده بلطف
# دون أن يكسر الإنتاج (النظام يسقط إلى البديل المحلي ويخبر المستخدم).
# لا تضع أيًا من هذه المفاتيح في متغيرات NEXT_PUBLIC_ — خادم فقط.
# ==========================================================================

# --- اختيار المزوّد لكل خدمة ---
# elevenlabs | openai | auto  (auto = ElevenLabs إن توفّر، وإلا OpenAI)
PROMO_TTS_PROVIDER=auto
# anthropic | openai | auto
PROMO_LLM_PROVIDER=auto
# motion (المحرّك المدمج، متاح دائمًا) | replicate
PROMO_I2V_PROVIDER=motion
# replicate | (فارغ = تعطيل المشاهد المساندة المولّدة)
PROMO_GENVIDEO_PROVIDER=
PROMO_RENDER_PROVIDER=ffmpeg

# --- التعليق الصوتي ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# تجاوز معرّف أي صوت لدى المزوّد: PROMO_VOICE_<ID بأحرف كبيرة>
# مثال: PROMO_VOICE_MALE_FORMAL_DEEP=xxxxxxxx

# --- التوليد المرئي (تحريك الصور والمشاهد المساندة) ---
REPLICATE_API_TOKEN=
REPLICATE_I2V_MODEL=
REPLICATE_GENVIDEO_MODEL=

# --- نماذج النصوص (اختياري؛ بدونها يُبنى النص من بيانات البرنامج مباشرة) ---
PROMO_ANTHROPIC_MODEL=claude-sonnet-5
PROMO_OPENAI_MODEL=gpt-4o

# --- الخطوط (El Messiri وزنان: العناوين والمتن) ---
PROMO_FONT_PATH=public/fonts/ElMessiri.ttf
PROMO_FONT_BODY_PATH=public/fonts/ElMessiri-Regular.ttf
PROMO_FALLBACK_FONT_PATH=public/fonts/Cairo.ttf

# ملاحظة: الموسيقى والشعارات الرسمية لا تُضبط هنا — يرفعها المدير من
# لوحة الإدارة ← مكتبة البرومو، وتُخزَّن في جدول promo_library.

# --- أداء العامل الخلفي ---
PROMO_RENDER_CONCURRENCY=2
PROMO_SCENE_TIMEOUT=180
